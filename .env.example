# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (SQLite local demo). For production PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eshop?sslmode=require
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Direct settlement — customers pay via OPay, Moniepoint, PalmPay, UBA, etc.
SETTLEMENT_UBA_ACCOUNT=2087806036
SETTLEMENT_UBA_NAME=Ibrahim Emmanuel Haruna
SETTLEMENT_OPAY_ACCOUNT=9139127576
SETTLEMENT_OPAY_NAME=Emmanuel Ibrahim

# Object storage — local /public/uploads by default. Optional S3/R2 override:
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email — local outbox by default (visible in Admin → Settings).
# Optional Resend (https://resend.com) for live SMTP delivery:
EMAIL_API_KEY=
EMAIL_FROM="E-Shop <noreply@eshop.market>"

# Background job queue for large CSV / XLSX imports (optional; in-process chunks when empty)
JOB_QUEUE_URL=
JOB_QUEUE_TOKEN=

# Advertising: CPC debit on sponsored clicks uses test-mode minor units when live ad billing is not configured.
# Campaign metrics are always derived from AdEvent rows — never fabricated.

# Local demo seed only — never use these in production
SEED_ADMIN_EMAIL=admin@eshop.local
SEED_ADMIN_PASSWORD=
SEED_VENDOR_EMAIL=vendor@eshop.local
SEED_VENDOR_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@eshop.local
SEED_CUSTOMER_PASSWORD=
