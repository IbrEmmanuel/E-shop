# Site (use your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (required on Vercel — SQLite will not work there)
# Neon / Supabase / Vercel Postgres — use the connection string they give you:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eshop?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Must match the live site origin on Vercel, e.g. https://your-app.vercel.app
AUTH_URL=http://localhost:3000

# Comma-separated emails elevated to SUPER_ADMIN on next successful login
SUPER_ADMIN_EMAIL=

# Optional hosted checkout (Paystack). When set, checkout redirects to provider.
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=

# Direct settlement — customers pay via OPay, Moniepoint, PalmPay, UBA, etc.
# Used when PAYMENT_SECRET_KEY is empty (transfer + server verification).
SETTLEMENT_UBA_ACCOUNT=2087806036
SETTLEMENT_UBA_NAME=Ibrahim Emmanuel Haruna
SETTLEMENT_OPAY_ACCOUNT=9139127576
SETTLEMENT_OPAY_NAME=Emmanuel Ibrahim

# Object storage — local /public/uploads by default. Optional S3/R2 override:
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email — local outbox by default (visible in Admin → Settings).
EMAIL_API_KEY=
EMAIL_FROM="E-Shop <noreply@eshop.market>"

JOB_QUEUE_URL=
JOB_QUEUE_TOKEN=

# Local seed only — never use these in production
SEED_ADMIN_EMAIL=admin@eshop.local
SEED_ADMIN_PASSWORD=
SEED_VENDOR_EMAIL=vendor@eshop.local
SEED_VENDOR_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@eshop.local
SEED_CUSTOMER_PASSWORD=
